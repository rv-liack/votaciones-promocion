# Copia este archivo como `.env` y completa los valores.
# NUNCA expongas la service_role key en el frontend: solo la anon key.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
# Opcional: URL base del bucket de Supabase Storage para imágenes.
# Si se omite, se deriva automáticamente de VITE_SUPABASE_URL.
# VITE_SUPABASE_STORAGE_URL=https://tu-proyecto.supabase.co/storage/v1/object/public/proposals
